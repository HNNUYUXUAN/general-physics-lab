{
  "schema_version": 1,
  "id": "course-01/density",
  "title": "物质密度的测量",
  "data_version": "1.0.0",
  "parameters": {
    "temperature_c": 21.8,
    "water_density_g_cm3": 0.99779,
    "assumed_mass_error_limit_g": 0.01
  },
  "units": {
    "mass": "g",
    "density": "g/cm^3",
    "volume": "cm^3"
  },
  "assumptions": [
    "忽略水密度的标准不确定度",
    "分别称量的质量均值视为互不相关",
    "0.01 g 为记录位数推断的条件误差限，非已核实仪器指标",
    "均匀分布 B 类标准不确定度为误差限除以 sqrt(3)",
    "忽略空气浮力、吊丝排水和温度漂移的修正"
  ]
}
