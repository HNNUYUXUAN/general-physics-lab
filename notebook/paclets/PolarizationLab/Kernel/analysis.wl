oaRows[root_,index_] := Rest[Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"]];
oaNum[s_] := If[NumberQ[s],s,ToExpression[s]];
oaAngle[s_] := Module[{p},p=ToExpression/@StringCases[ToString[s],RegularExpression["-?[0-9]+(?:[.][0-9]+)?"]];p[[1]]+If[Length[p]>1,p[[2]]/60,0]+If[Length[p]>2,p[[3]]/3600,0]];
oaSep[a_,b_] := Abs[Mod[a-b+180,360]-180];
oaMeanA[v_] := {Mean[v],StandardDeviation[v]/Sqrt[Length[v]]};
oaMetric[v_,unit_,label_] := <|"value"->N[v],"unit"->unit,"label"->label|>;
oaTable[h_,r_] := <|"headers"->h,"rows"->r|>;
oaTex[s_] := Module[{q=ToString[s],p},If[StringContainsQ[q,"\:00b0"],p=StringCases[q,RegularExpression["[0-9]+(?:[.][0-9]+)?"]];If[Length[p]>=2,Return["$"<>p[[1]]<>"^{\\circ}"<>p[[2]]<>"^{\\prime}$"]]];StringReplace[q,{"\:03b1B"->"$\\alpha_B$","\:03b8\:2081"->"$\\theta_1$","\:03b8\:2082"->"$\\theta_2$","\:03b8\:2083"->"$\\theta_3$","\:03b8\:2084"->"$\\theta_4$","\:03b4\:1d62"->"$\\delta_i$","\:03b4min,i"->"$\\delta_{\\min,i}$","\:03c6\:1d62"->"$\\varphi_i$","A\:1d62"->"$A_i$"}]];
oaSource[root_,index_] := Module[{raw},raw=Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"];oaTable[oaTex/@First[raw],Map[oaTex,Rest[raw],{2}]]];


compute[root_] := Module[{brew,angles,mean,ua,n,un,x,y,xc,a,b,p,res,r2},brew=oaAngle[#[[2]]]&/@oaRows[root,1];angles=Map[oaNum,oaRows[root,2],{2}];{mean,ua}=oaMeanA[brew];n=Tan[mean Degree];un=(1+n^2)ua Degree;x=N[Cos[angles[[All,1]]Degree]^2];y=angles[[All,2]];xc=x-Mean[x];a=xc.(y-Mean[y])/(xc.xc);b=Mean[y]-a Mean[x];p=a x+b;res=y-p;r2=1-(res.res)/((y-Mean[y]).(y-Mean[y]));
 <|"metrics"-><|"brewster_angle_deg"->oaMetric[mean,"deg","\:5e03\:5112\:65af\:7279\:89d2\:5747\:503c"],"brewster_type_a_arcmin"->oaMetric[ua 60,"arcmin","\:5e03\:5112\:65af\:7279\:89d2\:5747\:503cA\:7c7b"],"glass_refractive_index"->oaMetric[n,"1","\:73bb\:7483\:6298\:5c04\:7387"],"glass_index_type_a"->oaMetric[un,"1","\:89d2\:5ea6\:91cd\:590d\:6027\:4f20\:64ad\:5206\:91cf"],"malus_amplitude_ma"->oaMetric[a,"mA","\:9a6c\:5415\:65af\:62df\:5408\:5e45\:5ea6"],"malus_background_ma"->oaMetric[b,"mA","\:62df\:5408\:80cc\:666f"],"malus_r_squared"->oaMetric[r2,"1","\:9a6c\:5415\:65af\:62df\:5408\:51b3\:5b9a\:7cfb\:6570"]|>,"tables"-><|"table1"->oaSource[root,1],"table2"->oaTable[{"\:68c0\:504f\:5668\:89d2 $\\theta$ / \:00b0","\:5149\:7535\:6d41 $I$ / mA"},angles],"table3"->oaTable[{"$\\theta$ / \:00b0","$\\cos^2\\theta$","\:5b9e\:6d4b $I$ / mA","\:62df\:5408 $I$ / mA"},MapThread[{#1[[1]],Round[#2,10^-8],#1[[2]],Round[#3,10^-8]}&,{angles,x,p}]]|>,"series"-><|"malus-fit"-><|"x"->x,"y"->y,"x_label"->"$\\cos^2\\theta$","y_label"->"\:5149\:7535\:6d41 $I$ / mA","label"->"\:89c2\:6d4b\:503c","fit"->True|>|>,"notes"->{"\:5e03\:5112\:65af\:7279\:89d2\:53ea\:4f20\:64ad\:91cd\:590d\:6027\:ff1b\:672a\:542b\:96f6\:70b9\:3001\:4eea\:5668\:3001\:73bb\:7483\:8868\:9762\:5206\:91cf\:3002","\:9a6c\:5415\:65af\:7b49\:6743\:62df\:5408\:6ca1\:6709\:5149\:7535\:6d41\:548c\:89d2\:5ea6\:9010\:70b9\:8bef\:5dee\:ff0c\:4e0d\:7ed9\:5b8c\:6574\:53c2\:6570\:4e0d\:786e\:5b9a\:5ea6\:3002","\:6ce2\:7247\:63d2\:5165\:540e\:7684\:72b6\:6001\:6ca1\:6709\:5b9a\:91cf\:8bb0\:5f55\:ff0c\:4e0d\:636e\:6b64\:91cd\:5efa\:5b9e\:6d4b\:504f\:632f\:692d\:5706\:3002"}|>
];
explore["malus-offset",r_] := With[{a=r["metrics"]["malus_amplitude_ma"]["value"],b=r["metrics"]["malus_background_ma"]["value"],obs=r["tables"]["table2"]["rows"]},Manipulate[Show[ListPlot[obs,PlotStyle->Black,PlotMarkers->{Graphics[{White,Disk[],Black,Circle[]}],10}],Plot[a Cos[(x-offset)Degree]^2+b,{x,0,90},PlotStyle->Black],Frame->True,Axes->False,FrameLabel->{styled["\:68c0\:504f\:5668\:89d2 \:03b8 / \:00b0"],styled["\:5149\:7535\:6d41 I / mA"]},ImageSize->650,BaseStyle->{FontFamily->"Times New Roman",FontSize->17}],{{offset,0,styled["\:6a21\:578b\:96f6\:70b9\:504f\:79fb \:03b8\:2080 / \:00b0"]},-10,10,1,Appearance->"Labeled"},SaveDefinitions->True]];
