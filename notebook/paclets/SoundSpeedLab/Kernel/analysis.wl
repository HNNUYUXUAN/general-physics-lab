 <|"metrics"->metrics,"tables"-><|"standing"-><|"headers"->headers,"rows"->{Join[{"$\\lambda_1 / \\mathrm{mm}$"},a[[All,2]],{N[Mean[a[[All,2]]]]}]}|>,
