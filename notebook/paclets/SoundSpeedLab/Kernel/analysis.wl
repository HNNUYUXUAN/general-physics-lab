compute[dir_] := Module[{cfg,p,a,f,temp,uf,ub,metrics=<||>,results={},unc={},key,label,lam,mean,sd,ua,ul,v,uv,gamma,ugamma,err,errgamma,names,values,units,labels,headers},
 cfg=Import[FileNameJoin[{dir,"experiment.json"}],"RawJSON"];p=cfg["parameters"];a=Rest[Import[FileNameJoin[{dir,"data","wavelengths.csv"}],"CSV"]];If[Length[a]!=10,Return[$Failed]];
 f=p["frequency_hz"];temp=p["temperature_c"]+273.15;uf=p["frequency_error_limit_hz"]/Sqrt[3];ub=p["wavelength_error_limit_mm"]/Sqrt[3];
 Do[key=If[i==1,"standing","phase"];label=If[i==1,"\:9a7b\:6ce2\:6cd5","\:76f8\:4f4d\:6bd4\:8f83\:6cd5"];lam=a[[All,i+1]];mean=Mean[lam];sd=StandardDeviation[lam];ua=sd/Sqrt[10];ul=Sqrt[ua^2+ub^2];v=mean f/1000;uv=v Sqrt[(ul/mean)^2+(uf/f)^2];gamma=p["air_molar_mass_kg_mol"]v^2/(p["gas_constant_j_molk"]temp);ugamma=2gamma uv/v;err=100Abs[v-p["reference_speed_m_s"]]/p["reference_speed_m_s"];errgamma=100Abs[gamma-p["reference_gamma"]]/p["reference_gamma"];
 names={"wavelength","sample_sd","wavelength_uncertainty_a","wavelength_uncertainty","speed","speed_uncertainty","relative_deviation","gamma","gamma_uncertainty","gamma_deviation"};values={mean,sd,ua,ul,v,uv,err,gamma,ugamma,errgamma};units={"mm","mm","mm","mm","m/s","m/s","%","1","1","%"};labels={"\:5e73\:5747\:6ce2\:957f","\:6ce2\:957f\:6837\:672c\:6807\:51c6\:5dee","\:6ce2\:957f\:5747\:503cA\:7c7b\:4e0d\:786e\:5b9a\:5ea6","\:6ce2\:957f\:6761\:4ef6\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:58f0\:901f","\:58f0\:901f\:6761\:4ef6\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:58f0\:901f\:76f8\:5bf9\:53c2\:8003\:5dee\:5f02","\:7a7a\:6c14\:6bd4\:70ed\:5bb9\:6bd4","\:6bd4\:70ed\:5bb9\:6bd4\:6761\:4ef6\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:6bd4\:70ed\:5bb9\:6bd4\:76f8\:5bf9\:7406\:8bba\:5dee\:5f02"};
