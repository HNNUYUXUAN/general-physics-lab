project[v_List]:={v[[1]]-v[[2]]+v[[3]]-v[[4]],Total[v],v[[1]]+v[[2]]-v[[3]]-v[[4]],v[[1]]-v[[2]]-v[[3]]+v[[4]]}/4;
fit[x_List,y_List]:=Module[{xm=Mean[x],ym=Mean[y],a,b,res},a=Total[(x-xm)(y-ym)]/Total[(x-xm)^2];b=ym-a xm;res=y-a x-b;{a,b,1-Total[res^2]/Total[(y-ym)^2]}];
compute[dir_]:=Module[{cfg,metrics=<||>,tables=<||>,series=<||>,values=<||>,rows,x,raw,parts,y,xlabel,a,b,r2,relative,ratio},
 cfg=Import[FileNameJoin[{dir,"experiment.json"}],"RawJSON"];
 Do[rows=Rest[Import[FileNameJoin[{dir,"data",key<>".csv"}],"CSV"]];x=N[rows[[All,1]]];raw=N[rows[[All,2;;5]]];parts=project/@raw;y=parts[[All,1]];AssociateTo[values,key->y];
 xlabel=Switch[key,"working_current","\:5de5\:4f5c\:7535\:6d41 $I_S\\,/\\,\\mathrm{mA}$","magnet_current","\:52b1\:78c1\:7535\:6d41 $I_M\\,/\\,\\mathrm{mA}$",_,"\:4f4d\:7f6e $X\\,/\\,\\mathrm{mm}$"];
