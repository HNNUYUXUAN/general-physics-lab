 Do[AssociateTo[metrics,key<>"_point"<>ToString[j]<>"_channel"<>ToString[n]-><|"value"->raw[[j,n]],"unit"->"mV","label"->key<>" \:539f\:59cb\:901a\:9053\:7535\:538b"|>],{j,Length[raw]},{n,4}];
