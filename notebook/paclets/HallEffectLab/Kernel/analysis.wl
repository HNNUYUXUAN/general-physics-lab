 relative=values["position"]/First[values["position"]];AssociateTo[series,"relative_field"-><|"x"->series["position"]["x"],"y"->relative,"x_label"->"\:4f4d\:7f6e $X\\,/\\,\\mathrm{mm}$","y_label"->"\:76f8\:5bf9\:78c1\:573a $B(X)/B(2\\,\\mathrm{mm})$","label"->"\:56fa\:5b9a\:5de5\:4f5c\:7535\:6d41\:548c\:7075\:654f\:5ea6\:6761\:4ef6"|>];
 ratio=Last[values["working_current"]]/Last[values["magnet_current"]];AssociateTo[metrics,"same_setting_voltage_ratio"-><|"value"->ratio,"unit"->"1","label"->"\:4e24\:8868\:540c\:6807\:8bb0\:8bbe\:7f6e\:970d\:5c14\:6295\:5f71\:6bd4\:503c"|>];
