    Cell[StyleData["Notebook"], FontFamily -> "Times New Roman", 
     FontColor -> GrayLevel[0]], Cell[StyleData["Title"], 
     FontFamily -> "SimSun", FontColor -> GrayLevel[0], FontSize -> 28, 
     FontWeight -> "Plain", TextAlignment -> Center, 
     CellMargins -> {{60, 60}, {24, 24}}], Cell[StyleData["Section"], 
     FontFamily -> "SimSun", FontColor -> GrayLevel[0], FontSize -> 23, 
     FontWeight -> "Plain", CellMargins -> {{60, 60}, {18, 30}}], 
    Cell[StyleData["Subsection"], FontFamily -> "SimSun", 
     FontColor -> GrayLevel[0], FontSize -> 19, FontWeight -> "Plain"], 
    Cell[StyleData["Subsubsection"], FontFamily -> "SimSun", 
     FontColor -> GrayLevel[0], FontSize -> 17, FontWeight -> "Plain"], 
    Cell[StyleData["Text"], FontSize -> 16, LineSpacing -> {1.5, 2}, 
     CellMargins -> {{60, 60}, {10, 10}}], Cell[StyleData["Caption"], 
     FontSize -> 16, TextAlignment -> Center, CellMargins -> 
      {{60, 60}, {16, 8}}], Cell[StyleData["Output"], FontSize -> 15, 
     TextAlignment -> Center, CellMargins -> {{60, 60}, {12, 12}}], 
    Cell[StyleData["InlineFormula"], FontFamily -> "Times New Roman", 
     AutoSpacing -> False, ShowAutoStyles -> False, 
     AutoMultiplicationSymbol -> False], Cell[StyleData["DisplayFormula"], 
     FontFamily -> "Times New Roman", FontSize -> 18, AutoSpacing -> False, 
     ShowAutoStyles -> False, AutoMultiplicationSymbol -> False, 
     TextAlignment -> Center, CellMargins -> {{60, 60}, {12, 12}}]}], 
 CellContext -> Notebook, WindowSize -> {1180, 850}, 
 CommonDefaultFormatTypes -> {"Output" -> StandardForm}, 
 BaseStyle -> {FontFamily -> "Times New Roman", FontSize -> 16}]
