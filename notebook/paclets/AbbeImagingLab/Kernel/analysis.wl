oaRows[root_,index_] := Rest[Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"]];
oaNum[s_] := If[NumberQ[s],s,ToExpression[s]];
oaAngle[s_] := Module[{p},p=ToExpression/@StringCases[ToString[s],RegularExpression["-?[0-9]+(?:[.][0-9]+)?"]];p[[1]]+If[Length[p]>1,p[[2]]/60,0]+If[Length[p]>2,p[[3]]/3600,0]];
oaSep[a_,b_] := Abs[Mod[a-b+180,360]-180];
oaMeanA[v_] := {Mean[v],StandardDeviation[v]/Sqrt[Length[v]]};
oaMetric[v_,unit_,label_] := <|"value"->N[v],"unit"->unit,"label"->label|>;
oaTable[h_,r_] := <|"headers"->h,"rows"->r|>;
oaTex[s_] := Module[{q=ToString[s],p},If[StringContainsQ[q,"\:00b0"],p=StringCases[q,RegularExpression["[0-9]+(?:[.][0-9]+)?"]];If[Length[p]>=2,Return["$"<>p[[1]]<>"^{\\circ}"<>p[[2]]<>"^{\\prime}$"]]];StringReplace[q,{"\:03b8\:2081"->"$\\theta_1$","\:03b8\:2082"->"$\\theta_2$","\:03b8\:2083"->"$\\theta_3$","\:03b8\:2084"->"$\\theta_4$","\:03b4\:1d62"->"$\\delta_i$","\:03b4min,i"->"$\\delta_{\\min,i}$","\:03c6\:1d62"->"$\\varphi_i$","A\:1d62"->"$A_i$"}]];
oaSource[root_,index_] := Module[{raw},raw=Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"];oaTable[oaTex/@First[raw],Map[oaTex,Rest[raw],{2}]]];


compute[root_] := Module[{spectrum,observations,visibility,first,position,d,frequency,x,y,a,b,dfit},spectrum=Map[oaNum,oaRows[root,1],{2}];observations=oaRows[root,2];visibility=oaNum/@observations[[All,4]];first=Select[spectrum,Abs[#[[1]]]==1&][[All,2]];position=Mean[Abs[first]];d=.0006328 150/position;frequency=1/d;x=spectrum[[All,1]];y=spectrum[[All,2]];a=((x-Mean[x]).(y-Mean[y]))/Total[(x-Mean[x])^2];b=Mean[y]-a Mean[x];dfit=.0006328 150/a;
 <|"metrics"-><|"first_order_mean_abs_mm"->oaMetric[position,"mm","\:6b63\:8d1f\:4e00\:7ea7\:5e73\:5747\:7edd\:5bf9\:4f4d\:7f6e"],"grating_period_mm"->oaMetric[d,"mm","\:4e00\:7ea7\:4f4d\:7f6e\:5149\:6805\:5468\:671f"],"spatial_frequency_per_mm"->oaMetric[frequency,"1/mm","\:57fa\:9891"],"spectrum_slope_mm"->oaMetric[a,"mm","\:5168\:7ea7\:6b21\:9891\:8c31\:4f4d\:7f6e\:62df\:5408\:659c\:7387"],"spectrum_intercept_mm"->oaMetric[b,"mm","\:9891\:8c31\:4f4d\:7f6e\:62df\:5408\:622a\:8ddd"],"period_fit_mm"->oaMetric[dfit,"mm","\:5168\:7ea7\:6b21\:4f4d\:7f6e\:62df\:5408\:5149\:6805\:5468\:671f"],"visibility_zero_only"->oaMetric[visibility[[2]],"1","\:4ec5\:96f6\:7ea7\:8bb0\:5f55\:53ef\:89c1\:5ea6"],"visibility_unfiltered"->oaMetric[visibility[[1]],"1","\:672a\:6ee4\:6ce2\:8bb0\:5f55\:53ef\:89c1\:5ea6"]|>,"tables"-><|"table1"->oaTable[{"\:884d\:5c04\:7ea7\:6b21 $k$","\:9891\:8c31\:4f4d\:7f6e $\\xi$ / mm"},spectrum],"table2"->oaSource[root,2]|>,"series"-><|"spectrum-fit"-><|"x"->x,"y"->y,"x_label"->"\:884d\:5c04\:7ea7\:6b21 $k$","y_label"->"\:540e\:7126\:9762\:4f4d\:7f6e $\\xi$ / mm","label"->"\:89c2\:6d4b\:503c","fit"->True|>,"filter-visibility"-><|"x"->Range[5],"y"->visibility,"x_label"->"\:6ee4\:6ce2\:65b9\:5f0f\:5e8f\:53f7\:ff08\:5bf9\:5e94\:89c2\:5bdf\:8868\:ff09","y_label"->"\:8bb0\:5f55\:76f8\:5bf9\:53ef\:89c1\:5ea6","label"->"\:6e90\:8bb0\:5f55\:53ef\:89c1\:5ea6"|>|>,"notes"->{"\:53ef\:89c1\:5ea6\:53ea\:6709\:8bb0\:5f55\:7ed3\:679c\:ff0c\:672a\:9644\:6700\:5927\:6700\:5c0f\:5149\:5f3a\:ff0c\:65e0\:6cd5\:590d\:6838\:5176\:8ba1\:7b97\:3002","\:6ca1\:6709\:9891\:8c31\:590d\:632f\:5e45\:548c\:5149\:9611\:5c3a\:5bf8\:ff0c\:4e0d\:80fd\:4ece\:5f53\:524d\:8bb0\:5f55\:91cd\:5efa\:5b9e\:9645\:4e8c\:7ef4\:7269\:50cf\:3002","\:906e\:6321\:96f6\:7ea7\:540e\:7684\:53cd\:76f8\:6761\:7eb9\:4e3a\:89c2\:6d4b\:63cf\:8ff0\:ff0c\:4e0d\:80fd\:4ec5\:7531\:901a\:8fc7\:00b11\:65ad\:8a00\:666e\:904d\:53cd\:76f8\:3002"}|>
