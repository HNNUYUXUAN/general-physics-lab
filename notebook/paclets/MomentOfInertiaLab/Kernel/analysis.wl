 "beta"-><|"headers"->{"\:5bf9\:8c61","\:72b6\:6001","\:9010\:5dee1","\:9010\:5dee2","\:9010\:5dee3","\:9010\:5dee4","\:590d\:7b97\:5e73\:5747 / (rad s\:207b\:00b2)"},"rows"->Table[Join[{Switch[Ceiling[i/2],1,"\:7a7a\:8f7d\:7269\:53f0",2,"\:8f7d\:7269\:53f0\:4e0e\:5706\:73af",3,"\:8f7d\:7269\:53f0\:4e0e\:4e24\:5706\:67f1"],If[OddQ[i],"\:5300\:51cf\:901f","\:5300\:52a0\:901f"]},beta[[i]],{N[means[[i]]]}],{i,6}]|>,
 "reported_totals"-><|"headers"->{"\:9879\:76ee","\:5df2\:62a5\:603b\:60ef\:91cf / (kg m\:00b2)"},"rows"->{{"\:7a7a\:8f7d\:7269\:53f0",reported["platform"]},{"\:8f7d\:7269\:53f0\:4e0e\:5706\:73af",reported["platform_ring"]},{"\:8f7d\:7269\:53f0\:4e0e\:4e24\:5706\:67f1",reported["platform_two_cylinders"]}}|>,
