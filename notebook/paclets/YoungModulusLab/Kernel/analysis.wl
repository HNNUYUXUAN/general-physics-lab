compute[dir_] := Module[{cfg,p,u,d,load,corrected,dm,uad,x,dx,mdx,m,xc,yc,k,b,rr,res,uk,g,len,h,lever,pref,ed,els,geo,ud,uls,metrics,part,tables},
 cfg=Import[FileNameJoin[{dir,"experiment.json"}],"RawJSON"];p=cfg["parameters"];u=cfg["source_standard_uncertainties"];
 d=Rest[Import[FileNameJoin[{dir,"data","diameters.csv"}],"CSV"]];load=Rest[Import[FileNameJoin[{dir,"data","loading.csv"}],"CSV"]];
 corrected=d[[All,2]]-p["zero_offset_mm"];dm=Mean[corrected];uad=StandardDeviation[corrected]/Sqrt[6];x=(load[[All,2]]+load[[All,3]])/2;dx=x[[6;;10]]-x[[1;;5]];mdx=Mean[dx];m=load[[All,1]];xc=m-Mean[m];yc=x-Mean[x];k=xc.yc/(xc.xc);b=Mean[x]-k Mean[m];rr=xc.yc/Sqrt[(xc.xc)(yc.yc)];res=x-k m-b;uk=Sqrt[res.res/(Length[m]-2)/(xc.xc)];
 g=p["gravity_m_s2"];len=p["wire_length_mm"]/1000;h=p["mirror_distance_mm"]/1000;lever=p["lever_constant_mm"]/1000;pref=8g len h/(Pi(dm/1000)^2 lever);ed=pref*5/(mdx/1000);els=pref/(k/1000);
 geo=(u["wire_length_mm"]/p["wire_length_mm"])^2+(u["mirror_distance_mm"]/p["mirror_distance_mm"])^2+(2u["diameter_mm"]/dm)^2+(u["lever_constant_mm"]/p["lever_constant_mm"])^2;
 ud=ed Sqrt[geo+(u["mass_increment_kg"]/5)^2+(u["difference_mm"]/mdx)^2];uls=els Sqrt[geo+(uk/k)^2+(u["mass_increment_kg"]/5)^2];
 metrics=AssociationThread[{"mean_apparent_diameter","mean_corrected_diameter","diameter_uncertainty_a","mean_extension_difference","fit_slope","fit_intercept","correlation","slope_uncertainty","young_modulus_difference","young_modulus_regression","conditional_uncertainty_difference","conditional_uncertainty_regression"},MapThread[<|"value"->N[#1],"unit"->#2,"label"->#3|>&,
 {{Mean[d[[All,2]]],dm,uad,mdx,k,b,rr,uk,ed,els,ud,uls},{"mm","mm","mm","mm","mm/kg","mm","1","mm/kg","Pa","Pa","Pa","Pa"},{"\:76f4\:5f84\:89c6\:503c\:5747\:503c","\:96f6\:5dee\:4fee\:6b63\:76f4\:5f84\:5747\:503c","\:76f4\:5f84\:5747\:503cA\:7c7b\:4e0d\:786e\:5b9a\:5ea6","\:4e94\:7ec4\:9010\:5dee\:5e73\:5747","\:6807\:5c3a\:8d28\:91cf\:62df\:5408\:659c\:7387","\:6807\:5c3a\:62df\:5408\:622a\:8ddd","\:6807\:5c3a\:8d28\:91cf\:76f8\:5173\:7cfb\:6570","\:56de\:5f52\:659c\:7387\:6807\:51c6\:8bef\:5dee","\:9010\:5dee\:6768\:6c0f\:6a21\:91cf","\:56de\:5f52\:6768\:6c0f\:6a21\:91cf","\:9010\:5dee\:6761\:4ef6\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:56de\:5f52\:6761\:4ef6\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6"}}]];
 metrics["young_modulus_difference"]=Append[metrics["young_modulus_difference"],"uncertainty"->N[ud]];metrics["young_modulus_regression"]=Append[metrics["young_modulus_regression"],"uncertainty"->N[uls]];
 part[indices_] := {Prepend[m[[indices]],"\:8d28\:91cf\:89c6\:503c / kg"],Prepend[load[[indices,2]],"\:52a0\:529b\:523b\:5ea6 / mm"],Prepend[load[[indices,3]],"\:51cf\:529b\:523b\:5ea6 / mm"],Prepend[N[x[[indices]]],"\:5e73\:5747\:523b\:5ea6 / mm"]};
 tables=<|"geometry"-><|"headers"->{"$L / \\mathrm{mm}$","$H / \\mathrm{mm}$","$D / \\mathrm{mm}$"},"rows"->{{p["wire_length_mm"],p["mirror_distance_mm"],p["lever_constant_mm"]}}|>,
 "diameters"-><|"headers"->{"\:5e8f\:53f7","1","2","3","4","5","6","\:5e73\:5747\:503c / mm"},"rows"->{Join[{"\:76f4\:5f84\:89c6\:503c / mm"},d[[All,2]],{N[Mean[d[[All,2]]]]}],Join[{"\:4fee\:6b63\:76f4\:5f84 / mm"},N[corrected],{N[dm]}]}|>,
 "loading_first"-><|"headers"->{"\:5e8f\:53f7","1","2","3","4","5"},"rows"->part[Range[5]]|>,
 "loading_second"-><|"headers"->{"\:5e8f\:53f7","6","7","8","9","10"},"rows"->Append[part[Range[6,10]],Prepend[N[dx],"\:9010\:5dee / mm"]]|>,
 "uncertainty"-><|"headers"->{"\:7269\:7406\:91cf","\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:7269\:7406\:91cf","\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6"},"rows"->{{"$L / \\mathrm{mm}$",u["wire_length_mm"],"$H / \\mathrm{mm}$",u["mirror_distance_mm"]},{"$D / \\mathrm{mm}$",u["lever_constant_mm"],"\:8d28\:91cf\:589e\:91cf / kg",u["mass_increment_kg"]},{"$d / \\mathrm{mm}$",u["diameter_mm"],"\:9010\:5dee / mm",u["difference_mm"]}}|>|>;
 <|"metrics"->metrics,"tables"->tables,"series"-><|"loading_fit"-><|"x"->N[m],"y"->N[x],"x_label"->"\:62c9\:529b\:8d28\:91cf\:89c6\:503c / kg","y_label"->"\:5e73\:5747\:6807\:5c3a\:523b\:5ea6 / mm","fit"->True|>,"diameter_sequence"-><|"x"->Range[6],"y"->N[corrected],"x_label"->"\:6d4b\:91cf\:5e8f\:53f7","y_label"->"\:4fee\:6b63\:76f4\:5f84 / mm"|>|>,"notes"->{"\:9884\:7b97\:4e2d\:4e00\:6b21\:6027\:91cf\:53ca\:5408\:6210\:76f4\:5f84/\:9010\:5dee\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6\:6cbf\:7528\:6e90\:5df2\:7ed9\:6570\:503c\:ff0c\:6765\:6e90\:8bef\:5dee\:9650\:9700\:6838\:5b9e\:3002","\:8d28\:91cf\:589e\:91cf\:6821\:51c6\:8bef\:5dee\:5728\:56de\:5f52\:6cd5\:4e2d\:6309u_m/5\:76f8\:5bf9\:5c3a\:5ea6\:9879\:5904\:7406\:ff1b\:51e0\:4f55\:4e0e\:96f6\:5dee\:76f8\:5173\:6027\:672a\:91cf\:5316\:3002"}|>
];
