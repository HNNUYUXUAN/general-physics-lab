 AssociateTo[series,key-><|"x"->x,"y"->y,"x_label"->"\:6ed1\:5757\:4f4d\:7f6e $X=R_{AC}/R_0$","y_label"->If[kind=="current","\:7535\:6d41 / \:539f\:8bb0\:5f55\:5355\:4f4d","\:7535\:538b / \:539f\:8bb0\:5f55\:5355\:4f4d"],"label"->"K="<>ToString[k]|>];
