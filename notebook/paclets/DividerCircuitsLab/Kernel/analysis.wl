 AssociateTo[tables,"model_fit"-><|"headers"->{"\:63a5\:6cd5","\:53c2\:6570 $K$","\:6a21\:578b\:5e45\:5ea6\:ff08\:539f\:8bb0\:5f55\:5355\:4f4d\:ff09","\:5747\:65b9\:6839\:6b8b\:5dee\:ff08\:539f\:8bb0\:5f55\:5355\:4f4d\:ff09","\:6700\:5927\:76f8\:5bf9\:6b8b\:5dee / %"},"rows"->summary|>];
 x=N[Range[0,400]/400];Do[stem=keyK[k];Do[y=If[kind=="current",k/(k+x),shape[kind,k,#]&/@x];AssociateTo[series,"model_"<>kind<>"_K"<>stem-><|"x"->x,"y"->y,"x_label"->"\:6ed1\:5757\:4f4d\:7f6e $X$","y_label"->If[kind=="current","$I/I_{\\max}$","$U/E$"],"label"->"\:7406\:60f3\:6a21\:578b K="<>ToString[k],"model"->True|>],{kind,{"current","voltage"}}];
