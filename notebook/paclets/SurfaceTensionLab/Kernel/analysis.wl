meanUncertainty[x_] := StandardDeviation[x]/Sqrt[Length[x]];
compute[dir_] := Module[{cfg,p,cal,pull,dia,v,dv,delta,k,f,xc,yc,kls,b,rr,diffs,dmean,di,dout,len,alpha,qv,qd,ud,up,ul,uk,ualpha,metrics,tables},
 cfg=Import[FileNameJoin[{dir,"experiment.json"}],"RawJSON"];p=cfg["parameters"];
 cal=Rest[Import[FileNameJoin[{dir,"data","calibration.csv"}],"CSV"]];pull=Rest[Import[FileNameJoin[{dir,"data","pulls.csv"}],"CSV"]];dia=Rest[Import[FileNameJoin[{dir,"data","diameters.csv"}],"CSV"]];
 v=(cal[[All,2]]+cal[[All,3]])/2;dv=v[[5;;8]]-v[[1;;4]];delta=Mean[dv];k=p["gravity_m_s2"] .002/delta;f=cal[[All,1]]10^-6 p["gravity_m_s2"];xc=v-Mean[v];yc=f-Mean[f];kls=xc.yc/(xc.xc);b=Mean[f]-kls Mean[v];rr=xc.yc/Sqrt[(xc.xc)(yc.yc)];
 diffs=pull[[All,2]]-pull[[All,3]];dmean=Mean[diffs];di=Mean[dia[[All,2]]];dout=Mean[dia[[All,3]]];len=Pi(di+dout)/1000;alpha=k dmean/len;
 qv=p["voltage_resolution_mv"]/Sqrt[12];qd=p["diameter_resolution_mm"]/Sqrt[12];ud=Sqrt[meanUncertainty[dv]^2+(qv/2)^2];up=Sqrt[meanUncertainty[diffs]^2+2qv^2/5];ul=Pi Sqrt[meanUncertainty[dia[[All,2]]]^2+meanUncertainty[dia[[All,3]]]^2+2qd^2/5]/1000;uk=k ud/delta;ualpha=alpha Sqrt[(uk/k)^2+(up/dmean)^2+(ul/len)^2];
 metrics=AssociationThread[{"calibration_difference","conversion_difference","conversion_regression","calibration_intercept","calibration_correlation","mean_pull_difference","mean_inner_diameter","mean_outer_diameter","contact_length","surface_tension","surface_tension_regression","conditional_uncertainty","relative_deviation"},
 MapThread[<|"value"->N[#1],"unit"->#2,"label"->#3|>&,{{delta,k,kls,b,rr,dmean,di,dout,len,alpha,kls dmean/len,ualpha,100Abs[alpha-p["reference_n_m"]]/p["reference_n_m"]},{"mV","N/mV","N/mV","N","1","mV","mm","mm","m","N/m","N/m","N/m","%"},{"\:56db\:7ec4\:9010\:5dee\:5e73\:5747","\:9010\:5dee\:8f6c\:6362\:7cfb\:6570","\:6700\:5c0f\:4e8c\:4e58\:8f6c\:6362\:7cfb\:6570","\:6807\:5b9a\:62df\:5408\:622a\:8ddd","\:6807\:5b9a\:76f8\:5173\:7cfb\:6570","\:62c9\:8131\:8bfb\:6570\:5dee\:5e73\:5747","\:5e73\:5747\:5185\:5f84","\:5e73\:5747\:5916\:5f84","\:63a5\:89e6\:7ebf\:603b\:957f\:5ea6","\:9010\:5dee\:6cd5\:8868\:9762\:5f20\:529b\:7cfb\:6570","\:56de\:5f52\:6807\:5b9a\:8868\:9762\:5f20\:529b\:7cfb\:6570","\:6761\:4ef6\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:76f8\:5bf9\:53c2\:8003\:503c\:5dee\:5f02"}}]];
 metrics["surface_tension"]=Append[metrics["surface_tension"],"uncertainty"->N[ualpha]];
 tables=<|"calibration"-><|"headers"->{"\:8d28\:91cf / mg","\:589e\:91cd\:8bfb\:6570 / mV","\:51cf\:91cd\:8bfb\:6570 / mV","\:5e73\:5747\:8bfb\:6570 / mV","\:56db\:70b9\:9010\:5dee / mV"},"rows"->Table[{cal[[i,1]],cal[[i,2]],cal[[i,3]],N[v[[i]]],If[i<=4,N[dv[[i]]],"\:2014"]},{i,8}]|>,
 "pulls"-><|"headers"->{"\:6b21\:6570","$V_1 / \\mathrm{mV}$","$V_2 / \\mathrm{mV}$","$V_1-V_2 / \\mathrm{mV}$"},"rows"->Append[Table[Append[pull[[i]],N[diffs[[i]]]],{i,5}],{"\:5e73\:5747\:503c","\:2014","\:2014",N[dmean]}]|>,
 "diameters"-><|"headers"->{"\:6d4b\:91cf\:6b21\:6570","1","2","3","4","5","\:5e73\:5747\:503c / mm"},"rows"->{Join[{"\:5185\:5f84 / mm"},dia[[All,2]],{N[di]}],Join[{"\:5916\:5f84 / mm"},dia[[All,3]],{N[dout]}]}|>,
 "uncertainty"-><|"headers"->{"\:7269\:7406\:91cf","\:4f30\:503c","A\:7c7b\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:6761\:4ef6\:5408\:6210\:6807\:51c6\:4e0d\:786e\:5b9a\:5ea6","\:5355\:4f4d"},"rows"->{{"\:9010\:5dee\:5e73\:5747",N[delta],N[meanUncertainty[dv]],N[ud],"mV"},{"\:8f6c\:6362\:7cfb\:6570",N[k],"\:2014",N[uk],"N/mV"},{"\:62c9\:8131\:8bfb\:6570\:5dee\:5e73\:5747",N[dmean],N[meanUncertainty[diffs]],N[up],"mV"},{"\:63a5\:89e6\:7ebf\:957f\:5ea6",N[len],"\:2014",N[ul],"m"},{"\:8868\:9762\:5f20\:529b\:7cfb\:6570",N[alpha],"\:2014",N[ualpha],"N/m"}}|>|>;
 <|"metrics"->metrics,"tables"->tables,"series"-><|"calibration"-><|"x"->N[v],"y"->N[f],"x_label"->"\:5e73\:5747\:7535\:538b / mV","y_label"->"\:781d\:7801\:91cd\:529b / N","fit"->True|>,"pull_sequence"-><|"x"->Range[5],"y"->N[diffs],"x_label"->"\:62c9\:8131\:5e8f\:53f7","y_label"->"\:62c9\:8131\:524d\:540e\:7535\:538b\:5dee / mV"|>|>,"notes"->{"\:91cf\:5316\:8bfb\:6570\:5047\:5b9a\:72ec\:7acb\:3001\:8bef\:5dee\:534a\:5bbd\:4e3a\:534a\:5206\:8fa8\:529b\:ff0c\:5747\:5300\:5206\:5e03\:ff1bB\:7c7b\:6309\:7ebf\:6027\:7ec4\:5408\:53ca\:5747\:503c\:7cfb\:6570\:4f20\:64ad\:3002","\:781d\:7801\:8d28\:91cf\:3001g\:3001\:6da6\:6e7f\:3001\:6db2\:819c\:91cd\:91cf\:53ca\:8fdf\:6ede\:6f02\:79fb\:8bef\:5dee\:672a\:91cf\:5316\:ff0c\:5408\:6210\:4e3a\:6761\:4ef6\:9884\:7b97\:3002"}|>
];
explore["calibration-method",r_] := With[{volts=r["tables"]["pulls"]["rows"][[1;;5,4]],len=r["metrics"]["contact_length"]["value"],ks={r["metrics"]["conversion_difference"]["value"],r["metrics"]["conversion_regression"]["value"]}},
 Manipulate[ListLinePlot[Transpose[{Range[5],ks[[method]]volts/len}],PlotStyle->Black,PlotMarkers->{"\:25cb",10},Frame->{{True,False},{True,False}},Axes->False,
 FrameLabel->{Style["\:62c9\:8131\:5e8f\:53f7",FontFamily->"SimSun"],Style["\:8868\:9762\:5f20\:529b\:7cfb\:6570 / (N m\:207b\:00b9)",FontFamily->"SimSun"]},BaseStyle->{FontFamily->"Times New Roman",FontSize->18},GridLines->Automatic,GridLinesStyle->Directive[GrayLevel[.9]],PlotRange->All,ImageSize->800,ImagePadding->{{100,30},{65,25}}],
 {{method,1,Style["\:5b9a\:6807\:65b9\:6cd5",FontFamily->"SimSun"]},{1->"\:9010\:5dee\:6807\:5b9a",2->"\:6700\:5c0f\:4e8c\:4e58\:6807\:5b9a"},ControlType->PopupMenu},ControlPlacement->Bottom,SaveDefinitions->True]
];
