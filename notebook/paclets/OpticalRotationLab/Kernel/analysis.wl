oaRows[root_,index_] := Rest[Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"]];
oaNum[s_] := If[NumberQ[s],s,ToExpression[s]];
oaAngle[s_] := Module[{p},p=ToExpression/@StringCases[ToString[s],RegularExpression["-?[0-9]+(?:[.][0-9]+)?"]];p[[1]]+If[Length[p]>1,p[[2]]/60,0]+If[Length[p]>2,p[[3]]/3600,0]];
oaSep[a_,b_] := Abs[Mod[a-b+180,360]-180];
oaMeanA[v_] := {Mean[v],StandardDeviation[v]/Sqrt[Length[v]]};
oaMetric[v_,unit_,label_] := <|"value"->N[v],"unit"->unit,"label"->label|>;
oaTable[h_,r_] := <|"headers"->h,"rows"->r|>;
oaTex[s_] := Module[{q=ToString[s],p},If[StringContainsQ[q,"\:00b0"],p=StringCases[q,RegularExpression["[0-9]+(?:[.][0-9]+)?"]];If[Length[p]>=2,Return["$"<>p[[1]]<>"^{\\circ}"<>p[[2]]<>"^{\\prime}$"]]];StringReplace[q,{"\:03b8\:2081"->"$\\theta_1$","\:03b8\:2082"->"$\\theta_2$","\:03b8\:2083"->"$\\theta_3$","\:03b8\:2084"->"$\\theta_4$","\:03b4\:1d62"->"$\\delta_i$","\:03b4min,i"->"$\\delta_{\\min,i}$","\:03c6\:1d62"->"$\\varphi_i$","A\:1d62"->"$A_i$"}]];
oaSource[root_,index_] := Module[{raw},raw=Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"];oaTable[oaTex/@First[raw],Map[oaTex,Rest[raw],{2}]]];


compute[root_] := Module[{rows,a,left,right,phi,mean,ua,c,uc},rows=oaRows[root,1];a=Map[oaAngle,rows[[All,2;;5]],{2}];left=oaSep[#[[1]],#[[3]]]&/@a;right=oaSep[#[[2]],#[[4]]]&/@a;phi=(left+right)/2;{mean,ua}=oaMeanA[phi];c=mean/(66.46 2);uc=ua/(66.46 2);
 <|"metrics"-><|"rotation_magnitude_deg"->oaMetric[mean,"deg","\:65cb\:5149\:89d2\:7edd\:5bf9\:503c\:5747\:503c"],"rotation_type_a_arcmin"->oaMetric[ua 60,"arcmin","\:65cb\:5149\:89d2\:5747\:503cA\:7c7b"],"conditional_concentration_g_ml"->oaMetric[c,"g/mL","\:6307\:5b9a\:8517\:7cd6\:6bd4\:65cb\:5149\:7387\:53ca\:7ba1\:957f\:4e0b\:6d53\:5ea6"],"concentration_type_a_g_ml"->oaMetric[uc,"g/mL","\:53ea\:4f20\:64ad\:65cb\:5149\:89d2\:91cd\:590d\:6027\:5206\:91cf"],"maximum_vernier_disagreement_arcmin"->oaMetric[Max[Abs[left-right]]60,"arcmin","\:53cc\:6e38\:6807\:65cb\:5149\:89d2\:6700\:5927\:4e0d\:4e00\:81f4"]|>,"tables"-><|"table1"->oaSource[root,1],"table2"->oaTable[{"\:6b21\:6570","\:5de6\:6e38\:6807\:89d2\:5dee / \:00b0","\:53f3\:6e38\:6807\:89d2\:5dee / \:00b0","\:65cb\:5149\:89d2\:7edd\:5bf9\:503c / \:00b0"},MapThread[{oaNum[#1[[1]]],Round[#2,10^-8],Round[#3,10^-8],Round[#4,10^-8]}&,{rows,left,right,phi}]]|>,"series"-><|"rotation-repeat"-><|"x"->Range[5],"y"->phi,"x_label"->"\:6d4b\:91cf\:6b21\:6570","y_label"->"\:65cb\:5149\:89d2\:7edd\:5bf9\:503c $|\\varphi|$ / \:00b0","label"->"\:53cc\:6e38\:6807\:5e73\:5747"|>|>,"notes"->{"\:6db2\:67f1\:957f\:5ea62.00dm\:7531\:6e90\:4f5c\:8005\:6309\:5e38\:7528\:6837\:54c1\:7ba1\:53d6\:503c\:ff0c\:4e0d\:662f\:72ec\:7acb\:5b9e\:6d4b\:8bb0\:5f55\:3002","\:6e29\:5ea6\:3001\:6eb6\:6db2\:8eab\:4efd\:3001\:6bd4\:65cb\:5149\:7387\:548c\:7ba1\:957f\:8bef\:5dee\:672a\:8bb0\:5f55\:ff0c\:6d53\:5ea6\:662f\:7ed9\:5b9a\:5047\:8bbe\:4e0b\:7684\:53cd\:63a8\:3002","\:89d2\:5dee\:53d6\:7edd\:5bf9\:503c\:ff0c\:4e0d\:80fd\:7531\:6b64\:72ec\:7acb\:5224\:5b9a\:65cb\:5149\:65b9\:5411\:3002"}|>
