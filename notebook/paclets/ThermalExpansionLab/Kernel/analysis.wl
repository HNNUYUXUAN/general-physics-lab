oaRows[root_,index_] := Rest[Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"]];
oaNum[s_] := If[NumberQ[s],s,ToExpression[s]];
oaAngle[s_] := Module[{p},p=ToExpression/@StringCases[ToString[s],RegularExpression["-?[0-9]+(?:[.][0-9]+)?"]];p[[1]]+If[Length[p]>1,p[[2]]/60,0]+If[Length[p]>2,p[[3]]/3600,0]];
oaSep[a_,b_] := Abs[Mod[a-b+180,360]-180];
oaMeanA[v_] := {Mean[v],StandardDeviation[v]/Sqrt[Length[v]]};
oaMetric[v_,unit_,label_] := <|"value"->N[v],"unit"->unit,"label"->label|>;
oaTable[h_,r_] := <|"headers"->h,"rows"->r|>;
oaTex[s_] := Module[{q=ToString[s],p},If[StringContainsQ[q,"\:00b0"],p=StringCases[q,RegularExpression["[0-9]+(?:[.][0-9]+)?"]];If[Length[p]>=2,Return["$"<>p[[1]]<>"^{\\circ}"<>p[[2]]<>"^{\\prime}$"]]];StringReplace[q,{"\:03b8\:2081"->"$\\theta_1$","\:03b8\:2082"->"$\\theta_2$","\:03b8\:2083"->"$\\theta_3$","\:03b8\:2084"->"$\\theta_4$","\:03b4\:1d62"->"$\\delta_i$","\:03b4min,i"->"$\\delta_{\\min,i}$","\:03c6\:1d62"->"$\\varphi_i$","A\:1d62"->"$A_i$"}]];
oaSource[root_,index_] := Module[{raw},raw=Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"];oaTable[oaTex/@First[raw],Map[oaTex,Rest[raw],{2}]]];


compute[root_] := Module[{rows,t,s,l=150000.,x,k,a,e,uk,dif,ap,alpha,u,r2,metrics,tables},rows=oaRows[root,2];t=oaNum/@rows[[1,2;;]];s=oaNum/@rows[[2,2;;]];x=t-Mean[t];k=x.(s-Mean[s])/(x.x);a=Mean[s]-k Mean[t];e=s-(a+k t);uk=Sqrt[(e.e)/6/(x.x)];dif=s[[5;;8]]-s[[1;;4]];ap=dif/(l(t[[5;;8]]-t[[1;;4]]));alpha=k/l;u=uk/l;r2=1-(e.e)/((s-Mean[s]).(s-Mean[s]));
 metrics=<|"alpha_difference_per_k"->oaMetric[Mean[ap],"1/K","\:9010\:5dee\:5e73\:5747\:7ebf\:80c0\:7cfb\:6570"],"alpha_fit_per_k"->oaMetric[alpha,"1/K","\:6700\:5c0f\:4e8c\:4e58\:7ebf\:80c0\:7cfb\:6570"],"alpha_fit_residual_se_per_k"->oaMetric[u,"1/K","\:62df\:5408\:6b8b\:5dee\:4f20\:64ad\:5206\:91cf"],"slope_um_per_k"->oaMetric[k,"\:03bcm/K","\:6e29\:5ea6\:8bfb\:6570\:62df\:5408\:659c\:7387"],"slope_standard_error_um_per_k"->oaMetric[uk,"\:03bcm/K","\:6b8b\:5dee\:659c\:7387\:6807\:51c6\:8bef"],"intercept_um"->oaMetric[a,"um","\:62df\:5408\:622a\:8ddd"],"fit_r_squared"->oaMetric[r2,"1","\:62df\:5408\:51b3\:5b9a\:7cfb\:6570"],"reference_difference_percent"->oaMetric[Abs[alpha-17.25 10^-6]/(17.25 10^-6)100,"%","\:76f8\:5bf9\:6307\:5b9a\:53c2\:8003\:4e2d\:503c\:504f\:5dee"]|>;
 tables=<|"table1"->oaSource[root,1],"table2"->oaSource[root,2],"table3"->oaTable[{"\:914d\:5bf9","$t_i$ / \:00b0C","$t_{i+4}$ / \:00b0C","$S_i$ / \:03bcm","$S_{i+4}$ / \:03bcm","$\\Delta S_i$ / \:03bcm","$\\alpha_i$ / K$^{-1}$"},Table[{ToString[i]<>"\:2013"<>ToString[i+4],t[[i]],t[[i+4]],s[[i]],s[[i+4]],Round[dif[[i]],10^-8],ap[[i]]},{i,4}]],"table4"->oaTable[{"\:5e8f\:53f7","\:6e29\:5ea6 $t$ / \:00b0C","\:8bfb\:6570 $S$ / \:03bcm","$t^2$ / \:00b0C$^2$","$tS$ / (\:00b0C\:00b7\:03bcm)"},Append[Table[{i,t[[i]],s[[i]],t[[i]]^2,t[[i]]s[[i]]},{i,8}],{"\:5408\:8ba1",Total[t],Total[s],Total[t^2],t.s}]],"table5"->oaTable[{"\:9879\:76ee","\:8ba1\:7b97\:7ed3\:679c"},{{"\:659c\:7387 / (\:03bcm/K)",k},{"\:6b8b\:5dee\:659c\:7387\:6807\:51c6\:8bef / (\:03bcm/K)",uk},{"\:7ebf\:80c0\:7cfb\:6570 / K\:207b\:00b9",alpha},{"\:4ec5\:6b8b\:5dee\:4f20\:64ad\:5206\:91cf / K\:207b\:00b9",u},{"\:76f8\:5bf9\:6b8b\:5dee\:5206\:91cf / %",u/alpha 100}}]|>;
 <|"metrics"->metrics,"tables"->tables,"series"-><|"expansion-fit"-><|"x"->t,"y"->s,"x_label"->"\:6e29\:5ea6 $t$ / \:00b0C","y_label"->"\:5343\:5206\:8868\:8bfb\:6570 $S$ / \:03bcm","label"->"\:62a5\:544a\:4e0e\:8bb2\:4e49\:76f8\:540c\:7684\:793a\:4f8b\:6570\:636e","fit"->True|>|>,"notes"->{"\:516b\:7ec4\:8bfb\:6570\:4e0e\:914d\:5957\:8bb2\:4e49B\:793a\:4f8b\:5b8c\:5168\:4e00\:81f4\:ff0c\:4e0d\:80fd\:8ba4\:5b9a\:4e3a\:72ec\:7acb\:65b0\:589e\:89c2\:6d4b\:3002","150mm\:662f\:6807\:79f0\:957f\:5ea6\:ff1b\:62df\:5408\:6807\:51c6\:8bef\:672a\:5305\:542b\:6709\:6548\:957f\:5ea6\:3001\:6e29\:5ea6\:4e0e\:5343\:5206\:8868\:7cfb\:7edf\:8bef\:5dee\:3002"}|>
];
