oaRows[root_,index_] := Rest[Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"]];
oaNum[s_] := If[NumberQ[s],s,ToExpression[s]];
oaAngle[s_] := Module[{p},p=ToExpression/@StringCases[ToString[s],RegularExpression["-?[0-9]+(?:[.][0-9]+)?"]];p[[1]]+If[Length[p]>1,p[[2]]/60,0]+If[Length[p]>2,p[[3]]/3600,0]];
oaSep[a_,b_] := Abs[Mod[a-b+180,360]-180];
oaMeanA[v_] := {Mean[v],StandardDeviation[v]/Sqrt[Length[v]]};
oaMetric[v_,unit_,label_] := <|"value"->N[v],"unit"->unit,"label"->label|>;
oaTable[h_,r_] := <|"headers"->h,"rows"->r|>;
oaTex[s_] := Module[{q=ToString[s],p},If[StringContainsQ[q,"\:00b0"],p=StringCases[q,RegularExpression["[0-9]+(?:[.][0-9]+)?"]];If[Length[p]>=2,Return["$"<>p[[1]]<>"^{\\circ}"<>p[[2]]<>"^{\\prime}$"]]];StringReplace[q,{"\:0394x_p"->"$\\Delta x_p$","\:0394x_i"->"$\\Delta x_i$","z_p"->"$z_p$","z_i"->"$z_i$","\:03b8\:2081"->"$\\theta_1$","\:03b8\:2082"->"$\\theta_2$","\:03b8\:2083"->"$\\theta_3$","\:03b8\:2084"->"$\\theta_4$","\:03b4\:1d62"->"$\\delta_i$","\:03b4min,i"->"$\\delta_{\\min,i}$","\:03c6\:1d62"->"$\\varphi_i$","A\:1d62"->"$A_i$"}]];
oaSource[root_,index_] := Module[{raw},raw=Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"];oaTable[oaTex/@First[raw],Map[oaTex,Rest[raw],{2}]]];


compute[root_] := Module[{setup,image,ratio,spacing,mag,km,ku,mm,mu,visibility,exposure,difference},setup=Map[oaNum,oaRows[root,1],{2}];image=Map[oaNum,oaRows[root,2],{2}];ratio=setup[[All,6]]/setup[[All,5]];spacing=.6328/(2 Sin[setup[[All,4]]Degree/2]);mag=image[[All,5]]/image[[All,4]];{km,ku}=oaMeanA[ratio];{mm,mu}=oaMeanA[mag];visibility=2 Sqrt[ratio]/(1+ratio);exposure=(setup[[All,5]]+setup[[All,6]])setup[[All,7]];difference=Abs[setup[[All,3]]-setup[[All,2]]];
 <|"metrics"-><|"fringe_spacing_um"->oaMetric[Mean[spacing],"um","\:7406\:60f3\:5e73\:9762\:6ce2\:5e72\:6d89\:6761\:7eb9\:95f4\:8ddd"],"mean_intensity_ratio"->oaMetric[km,"1","\:53c2\:8003\:5149\:4e0e\:7269\:5149\:5149\:5f3a\:6bd4\:5747\:503c"],"intensity_ratio_type_a"->oaMetric[ku,"1","\:5149\:5f3a\:6bd4\:5747\:503cA\:7c7b"],"mean_magnification"->oaMetric[mm,"1","\:518d\:73b0\:6a2a\:5411\:653e\:5927\:7387\:5747\:503c"],"magnification_type_a"->oaMetric[mu,"1","\:653e\:5927\:7387\:5747\:503cA\:7c7b"],"ideal_visibility_mean"->oaMetric[Mean[visibility],"1","\:7b49\:504f\:632f\:5b8c\:5168\:76f8\:5e72\:7406\:8bba\:53ef\:89c1\:5ea6\:5747\:503c"],"mean_total_exposure_mj_cm2"->oaMetric[Mean[exposure],"mJ/cm^2","\:4e24\:675f\:5e73\:5747\:5149\:5f3a\:7684\:66dd\:5149\:91cf\:5747\:503c"],"maximum_path_difference_cm"->oaMetric[Max[difference],"cm","\:6700\:5927\:8bb0\:5f55\:5149\:8def\:5dee"]|>,"tables"-><|"table1"->oaSource[root,1],"table2"->oaSource[root,2],"table3"->oaTable[{"\:6b21\:6570","$I_r/I_o$"},MapThread[{#1[[1]],Round[#2,10^-8]}&,{setup,ratio}]],"table4"->oaTable[{"\:6b21\:6570","$\\Delta x_i/\\Delta x_p$"},MapThread[{#1[[1]],Round[#2,10^-8]}&,{image,mag}]]|>,"series"-><|"hologram-ratio"-><|"x"->Range[3],"y"->ratio,"x_label"->"\:6d4b\:91cf\:6b21\:6570","y_label"->"\:5149\:5f3a\:6bd4 $K=I_r/I_o$","label"->"\:8bb0\:5f55\:5149\:5f3a\:8ba1\:7b97"|>,"hologram-magnification"-><|"x"->Range[3],"y"->mag,"x_label"->"\:6d4b\:91cf\:6b21\:6570","y_label"->"\:6a2a\:5411\:653e\:5927\:7387 $M$","label"->"\:8bb0\:5f55\:7269\:50cf\:5c3a\:5bf8\:8ba1\:7b97"|>|>,"notes"->{"\:7406\:8bba\:53ef\:89c1\:5ea6\:5047\:5b9a\:76f8\:540c\:504f\:632f\:3001\:5b8c\:5168\:76f8\:5e72\:3001\:7b49\:6ce2\:524d\:7a33\:5b9a\:6027\:ff0c\:672a\:4f5c\:4e3a\:5b9e\:6d4b\:6761\:7eb9\:5bf9\:6bd4\:5ea6\:3002","\:76f8\:5e72\:957f\:5ea6\:548c\:5e72\:677f\:54cd\:5e94\:672a\:8bb0\:5f55\:ff0c\:4e0d\:80fd\:7531\:5149\:8def\:5dee\:5355\:72ec\:4fdd\:8bc1\:76f8\:5e72\:6216\:66dd\:5149\:6700\:4f73\:3002","\:53ea\:6709\:4e09\:6b21\:91cd\:590d\:ff0c\:4eea\:5668\:3001\:7269\:50cf\:5b9a\:4f4d\:548c\:5e72\:677f\:5904\:7406\:8bef\:5dee\:672a\:7ed9\:3002"}|>
];
hoView[r_,key_,value_] := Module[{ratio,k,angle,spacing,contrast,x},ratio=r["metrics"]["mean_intensity_ratio"]["value"];k=If[key=="intensity-ratio",ratio value,ratio];angle=If[key=="beam-angle",value,30];spacing=.6328/(2 Sin[angle Degree/2]);contrast=2 Sqrt[k]/(1+k);Column[{Style[Row[{"K = ",NumberForm[k,{6,3}],"; \:039b = ",NumberForm[spacing,{6,4}]," \:03bcm; V = ",NumberForm[contrast,{6,4}]}],FontFamily->"Times New Roman"],Plot[1+contrast Cos[2 Pi x/spacing],{x,0,6},PlotStyle->Black,PlotRange->{0,2.05},Frame->True,Axes->False,FrameLabel->{styled["\:5e72\:677f\:6a2a\:5411\:4f4d\:7f6e x / \:03bcm"],Style[Row[{"I / (",Subscript["I","o"],"+",Subscript["I","r"],")"}],FontFamily->"Times New Roman"]},ImageSize->650,BaseStyle->{FontFamily->"Times New Roman",FontSize->17}]},Alignment->Center]];
explore["intensity-ratio",r_] := Manipulate[hoView[r,"intensity-ratio",factor],{{factor,1,styled["\:5149\:5f3a\:6bd4 / \:8bb0\:5f55\:5747\:503c"]},.25,2,.05,Appearance->"Labeled"},SaveDefinitions->True];
explore["beam-angle",r_] := Manipulate[hoView[r,"beam-angle",angle],{{angle,30,styled["\:4e24\:675f\:5e73\:9762\:6ce2\:5939\:89d2 / \:00b0"]},10,60,5,Appearance->"Labeled"},SaveDefinitions->True];
