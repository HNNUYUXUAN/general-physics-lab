VerificationTest[Length[PLRawData[]["timing"]],18,TestID->"timing-count"]
VerificationTest[Length[PLRawData[]["diameters"]],6,TestID->"diameter-count"]
VerificationTest[PLFitLine[{1,2,3,4},{3,5,7,9}]["slope"],2,TestID->"analytic-linear-slope"]
VerificationTest[PLFitLine[{1,2,3,4},{3,5,7,9}]["intercept"],1,TestID->"analytic-linear-intercept"]
VerificationTest[FailureQ[PLFitLine[{1,1,1},{1,2,3}]],True,TestID->"degenerate-length-rejected"]
VerificationTest[Abs[PLPeriod[0.,1.,9.81]/(2 Pi/Sqrt[9.81])-1]<10^-12,True,TestID->"small-angle-limit"]
VerificationTest[FailureQ[PLPeriod[Pi,1.,9.81]],True,TestID->"separatrix-domain"]
VerificationTest[Module[{s=PLAnalyze[]["simulation"]},Abs[s["period_ode_s"]/s["period_exact_s"]-1]<10^-7],True,TestID->"ode-versus-elliptic-period"]
VerificationTest[PLAnalyze[]["simulation"]["relative_energy_drift"]<10^-7,True,TestID->"energy-conservation"]
VerificationTest[And@@Thread[Differences[Lookup[PLAnalyze[]["amplitude_scan"],"period_s"]]>0],True,TestID->"period-increases-with-amplitude"]
VerificationTest[FileExistsQ[PLNotebookPath[]],True,TestID->"notebook-link"]
VerificationTest[Names["Global`PL*"],{},TestID->"public-context-isolation"]
VerificationTest[Count[PLModelView[60,1.5,2.,False],_Graphics,Infinity]>=4,True,TestID->"interactive-model-graphics"]
VerificationTest[Head[PLModelView[]],Column,TestID->"interactive-default-model"]
VerificationTest[Head[PLAmplitudeView[45]],Column,TestID->"interactive-amplitude-view"]
VerificationTest[FreeQ[PLFitView[1],_PLFitView],True,TestID->"interactive-fit-subset"]
