compute[dir_] := Module[{cfg,p,records,v,m1,m2,mi,mf,water,steam,t1,t2,t3,cw,c1,c2,cap,q,sensible,latent,ell,ref,altm,altl,derivative,metrics,labels,symbols,rows,shifts},
 cfg=Import[FileNameJoin[{dir,"experiment.json"}],"RawJSON"];p=cfg["parameters"];
 records=Rest[Import[FileNameJoin[{dir,"data","observations.csv"}],"CSV"]];v=AssociationThread[records[[All,1]],records[[All,2]]];
 m1=v["inner_mass"];m2=v["stirrer_mass"];mi=v["initial_total_mass"];mf=v["final_total_mass"];water=mi-m1;steam=mf-mi;If[water<=0||steam<=m2,Return[$Failed]];
 t1=v["initial_voltage"]-p["kelvin_offset"];t2=v["final_voltage"]-p["kelvin_offset"];t3=p["steam_temperature_c"];cw=p["water_specific_heat_j_gk"];c1=p["inner_specific_heat_j_gk"];c2=p["stirrer_specific_heat_j_gk"];
 cap=water cw+m1 c1+m2 c2;q=cap(t2-t1);sensible=steam cw(t3-t2);latent=q-sensible;ell=latent/steam 1000;ref=p["reference_latent_heat_j_kg"];altm=steam-m2;altl=(q/altm-cw(t3-t2))1000;derivative=(cap/steam+cw)1000;
 metrics=AssociationThread[{"water_mass","steam_mass","initial_temperature","final_temperature","temperature_rise","steam_temperature_drop","system_heat_capacity","absorbed_heat","sensible_heat","latent_heat_total","latent_heat","relative_deviation","alternative_steam_mass","alternative_latent_heat","final_temperature_sensitivity"},
