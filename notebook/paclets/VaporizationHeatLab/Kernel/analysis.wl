 labels={"\:91cf\:70ed\:5668\:5185\:7b52\:8d28\:91cf","\:6405\:62cc\:5668\:8d28\:91cf","\:521d\:6001\:7b52\:4e0e\:6c34\:8d28\:91cf","\:672b\:6001\:603b\:8d28\:91cf","\:521d\:6e29\:7535\:538b","\:672b\:6e29\:7535\:538b","\:84b8\:6c7d\:7406\:8bba\:6e29\:5ea6\:7535\:538b"};symbols={"$m_1$","$m_2$","$m_{\\mathrm{i}}$","$m_{\\mathrm{f}}$","$U_1$","$U_2$","$U_3$"};
