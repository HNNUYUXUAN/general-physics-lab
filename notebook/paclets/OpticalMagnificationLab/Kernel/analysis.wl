oaRows[root_,index_] := Rest[Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"]];
oaNum[s_] := If[NumberQ[s],s,ToExpression[s]];
oaAngle[s_] := Module[{p},p=ToExpression/@StringCases[ToString[s],RegularExpression["-?[0-9]+(?:[.][0-9]+)?"]];p[[1]]+If[Length[p]>1,p[[2]]/60,0]+If[Length[p]>2,p[[3]]/3600,0]];
oaSep[a_,b_] := Abs[Mod[a-b+180,360]-180];
oaMeanA[v_] := {Mean[v],StandardDeviation[v]/Sqrt[Length[v]]};
oaMetric[v_,unit_,label_] := <|"value"->N[v],"unit"->unit,"label"->label|>;
oaTable[h_,r_] := <|"headers"->h,"rows"->r|>;
oaTex[s_] := Module[{q=ToString[s],p},If[StringContainsQ[q,"\:00b0"],p=StringCases[q,RegularExpression["[0-9]+(?:[.][0-9]+)?"]];If[Length[p]>=2,Return["$"<>p[[1]]<>"^{\\circ}"<>p[[2]]<>"^{\\prime}$"]]];StringReplace[q,{"\:03b8\:2081"->"$\\theta_1$","\:03b8\:2082"->"$\\theta_2$","\:03b8\:2083"->"$\\theta_3$","\:03b8\:2084"->"$\\theta_4$","\:03b4\:1d62"->"$\\delta_i$","\:03b4min,i"->"$\\delta_{\\min,i}$","\:03c6\:1d62"->"$\\varphi_i$","A\:1d62"->"$A_i$"}]];
oaSource[root_,index_] := Module[{raw},raw=Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"];oaTable[oaTex/@First[raw],Map[oaTex,Rest[raw],{2}]]];


compute[root_] := Module[{q,mm,um,mt,ut,calibration,k,uk,s,us,diameters,d,udrepeat,ud,metrics,tables},
 q=Map[oaNum,oaRows[root,#],{2}]&/@Range[4];{mm,um}=oaMeanA[q[[1,All,3]]/q[[1,All,2]]];{mt,ut}=oaMeanA[q[[2,All,2]]/q[[2,All,3]]];calibration=q[[3,All,2]]/q[[3,All,3]];{k,uk}=oaMeanA[calibration];{s,us}=oaMeanA[q[[4,All,2]]];diameters=k q[[4,All,2]];{d,udrepeat}=oaMeanA[diameters];ud=Sqrt[(s uk)^2+(k us)^2];
 metrics=<|"microscope_magnification"->oaMetric[mm,"1","\:663e\:5fae\:955c\:6295\:5f71\:653e\:5927\:7387"],"microscope_type_a"->oaMetric[um,"1","\:663e\:5fae\:955c\:653e\:5927\:7387\:5747\:503cA\:7c7b"],"telescope_magnification"->oaMetric[mt,"1","\:671b\:8fdc\:955c\:653e\:5927\:7387\:7edd\:5bf9\:503c"],"telescope_type_a"->oaMetric[ut,"1","\:671b\:8fdc\:955c\:653e\:5927\:7387\:5747\:503cA\:7c7b"],"eyepiece_scale_mm"->oaMetric[k,"mm/div","\:6d4b\:5fae\:76ee\:955c\:6bcf\:683c\:503c"],"eyepiece_scale_type_a_mm"->oaMetric[uk,"mm/div","\:6bcf\:683c\:503c\:5747\:503cA\:7c7b"],"wire_diameter_um"->oaMetric[d 1000,"um","\:7ec6\:4e1d\:76f4\:5f84\:5747\:503c"],"wire_repeat_type_a_um"->oaMetric[udrepeat 1000,"um","\:56fa\:5b9a\:6807\:5b9a\:4e0b\:7ec6\:4e1d\:5747\:503cA\:7c7b"],"wire_random_combined_um"->oaMetric[ud 1000,"um","\:6807\:5b9a\:4e0e\:5bbd\:5ea6\:91cd\:590d\:6027\:4f20\:64ad\:5206\:91cf"]|>;
 tables=<|"table1"->oaTable[{"\:6b21\:6570","$l_0$ / mm","$l$ / mm","$M_m$"},Map[{#[[1]],#[[2]],#[[3]],Round[#[[3]]/#[[2]],10^-8]}&,q[[1]]]],"table2"->oaTable[{"\:6b21\:6570","$l_1$ / mm","$l_2$ / mm","$|M_t|$"},Map[{#[[1]],#[[2]],#[[3]],Round[#[[2]]/#[[3]],10^-8]}&,q[[2]]]],"table3"->oaTable[{"\:6b21\:6570","$L$ / mm","$S$ / \:683c","$k$ / (mm/\:683c)"},MapThread[Join[#1,{Round[#2,10^-8]}]&,{q[[3]],calibration}]],"table4"->oaTable[{"\:6b21\:6570","\:5bbd\:5ea6 $s$ / \:683c","\:76f4\:5f84 $d$ / mm"},MapThread[Join[#1,{Round[#2,10^-8]}]&,{q[[4]],diameters}]]|>;
 <|"metrics"->metrics,"tables"->tables,"series"-><|"wire-repeat"-><|"x"->Range[5],"y"->diameters 1000,"x_label"->"\:6d4b\:91cf\:6b21\:6570","y_label"->"\:7ec6\:4e1d\:76f4\:5f84 $d$ / \:03bcm","label"->"\:5171\:7528\:6807\:5b9a\:5747\:503c"|>|>,"notes"->{"\:6807\:5b9a\:5747\:503c\:662f\:6240\:6709\:7ec6\:4e1d\:8bfb\:6570\:5171\:4eab\:7684\:4e58\:6cd5\:56e0\:5b50\:ff0c\:5176\:5206\:91cf\:4e0d\:80fd\:518d\:6b21\:968f\:7ec6\:4e1d\:91cd\:590d\:6b21\:6570\:7f29\:5c0f\:3002","\:672a\:7ed9\:6807\:5c3a\:3001\:6295\:5f71\:8ddd\:79bb\:548c\:5bf9\:7126\:7cfb\:7edf\:8bef\:5dee\:ff1b\:91cd\:590d\:6027\:4e0d\:7b49\:4e8e\:51c6\:786e\:5ea6\:3002"}|>
];
