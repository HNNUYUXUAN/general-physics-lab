oaRows[root_,index_] := Rest[Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"]];
oaNum[s_] := If[NumberQ[s],s,ToExpression[s]];
oaAngle[s_] := Module[{p},p=ToExpression/@StringCases[ToString[s],RegularExpression["-?[0-9]+(?:[.][0-9]+)?"]];p[[1]]+If[Length[p]>1,p[[2]]/60,0]+If[Length[p]>2,p[[3]]/3600,0]];
oaSep[a_,b_] := Abs[Mod[a-b+180,360]-180];
oaMeanA[v_] := {Mean[v],StandardDeviation[v]/Sqrt[Length[v]]};
oaMetric[v_,unit_,label_] := <|"value"->N[v],"unit"->unit,"label"->label|>;
oaTable[h_,r_] := <|"headers"->h,"rows"->r|>;
oaTex[s_] := Module[{q=ToString[s],p},If[StringContainsQ[q,"\:00b0"],p=StringCases[q,RegularExpression["[0-9]+(?:[.][0-9]+)?"]];If[Length[p]>=2,Return["$"<>p[[1]]<>"^{\\circ}"<>p[[2]]<>"^{\\prime}$"]]];StringReplace[q,{"\:03b8\:2081"->"$\\theta_1$","\:03b8\:2082"->"$\\theta_2$","\:03b8\:2083"->"$\\theta_3$","\:03b8\:2084"->"$\\theta_4$","\:03b4\:1d62"->"$\\delta_i$","\:03b4min,i"->"$\\delta_{\\min,i}$","\:03c6\:1d62"->"$\\varphi_i$","A\:1d62"->"$A_i$"}]];
oaSource[root_,index_] := Module[{raw},raw=Import[FileNameJoin[{root,"data","observations-"<>IntegerString[index,10,2]<>".csv"}],"CSV"];oaTable[oaTex/@First[raw],Map[oaTex,Rest[raw],{2}]]];


compute[root_] := Module[{raw,phis={},uas={},disagreements={},tables=<||>,a,l,rr,phi,mean,ua,rad,urad,d,ud,wave,uw,names,keys,metrics,delta},
 raw=oaRows[root,#]&/@Range[4];Do[a=Map[oaAngle,raw[[j,All,2;;5]],{2}];l=oaSep[#[[1]],#[[2]]]&/@a;rr=oaSep[#[[3]],#[[4]]]&/@a;phi=(l+rr)/4;{mean,ua}=oaMeanA[phi];AppendTo[phis,mean];AppendTo[uas,ua];disagreements=Join[disagreements,Abs[l-rr]60];AssociateTo[tables,"table"<>ToString[j]->oaTable[{"\:6b21\:6570","$V_1$","$V_1^{\\prime}$","$V_2$","$V_2^{\\prime}$","$\\varphi_i$ / \:00b0"},MapThread[Join[{oaNum[#1[[1]]]},oaTex/@#1[[2;;5]],{Round[#2,10^-8]}]&,{raw[[j]],phi}]]],{j,4}];
 rad=phis Degree;urad=uas Degree;d=546.1/Sin[rad[[2]]];ud=Abs[546.1 Cos[rad[[2]]]/Sin[rad[[2]]]^2 urad[[2]]];wave=d Sin[rad];uw=Sqrt[(Sin[rad]ud)^2+(d Cos[rad]urad)^2];uw[[2]]=0;
 names={"\:7d2b\:7ebf","\:7eff\:7ebf\:ff08\:6807\:5b9a\:ff09","\:9ec4\:7ebf1","\:9ec4\:7ebf2"};keys={"violet","green","yellow_1","yellow_2"};
 metrics=<|"grating_spacing_nm"->oaMetric[d,"nm","\:5149\:6805\:5e38\:6570"],"grating_spacing_type_a_nm"->oaMetric[ud,"nm","\:6807\:5b9a\:89d2\:91cd\:590d\:6027\:4f20\:64ad\:5206\:91cf"],"grating_lines_per_mm"->oaMetric[10^6/d,"1/mm","\:6bcf\:6beb\:7c73\:523b\:7ebf\:6570"]|>;
 Do[AssociateTo[metrics,{keys[[j]]<>"_wavelength_nm"->oaMetric[wave[[j]],"nm",names[[j]]<>"\:6ce2\:957f"],keys[[j]]<>"_type_a_nm"->oaMetric[uw[[j]],"nm",names[[j]]<>"\:6307\:5b9a\:91cd\:590d\:6027\:4f20\:64ad\:5206\:91cf"]}],{j,4}];delta=(phis[[4]]-phis[[3]])Degree;
 AssociateTo[metrics,{"yellow_angle_gap_arcmin"->oaMetric[(phis[[4]]-phis[[3]])60,"arcmin","\:53cc\:9ec4\:7ebf\:5e73\:5747\:89d2\:95f4\:9694"],"dispersion_empirical_rad_per_nm"->oaMetric[delta/2.06,"rad/nm","\:6307\:5b9a\:6ce2\:957f\:5dee\:4e0b\:5b9e\:9a8c\:8272\:6563"],"dispersion_theoretical_rad_per_nm"->oaMetric[1/(d Cos[Mean[rad[[3;;4]]]]),"rad/nm","\:5149\:6805\:65b9\:7a0b\:4e00\:7ea7\:5c40\:90e8\:8272\:6563"],"maximum_vernier_gap_arcmin"->oaMetric[Max[disagreements],"arcmin","\:4e24\:6e38\:6807\:6d4b\:5f97\:53cc\:4fa7\:89d2\:5dee\:6700\:5927\:4e0d\:4e00\:81f4"]}];
 AssociateTo[tables,"table5"->oaTable[{"\:8c31\:7ebf","\:5e73\:5747\:884d\:5c04\:89d2 / \:00b0","\:89d2\:5ea6\:5747\:503cA\:7c7b / \:2032","\:6ce2\:957f / nm","\:6307\:5b9aA\:7c7b\:4f20\:64ad\:5206\:91cf / nm"},MapThread[{#1,Round[#2,10^-8],Round[#3 60,10^-5],Round[#4,10^-5],Round[#5,10^-5]}&,{names,phis,uas,wave,uw}]]];
 <|"metrics"->metrics,"tables"->tables,"series"-><|"grating-angles"-><|"x"->Range[4],"y"->phis,"x_label"->"\:8c31\:7ebf\:5e8f\:53f7\:ff08\:7d2b\:3001\:7eff\:3001\:9ec41\:3001\:9ec42\:ff09","y_label"->"\:5e73\:5747\:884d\:5c04\:89d2 $\\varphi$ / \:00b0","label"->"\:4e00\:7ea7\:884d\:5c04\:89d2"|>|>,"notes"->{"\:7eff\:7ebf\:7528\:4f5c\:6807\:5b9a\:ff0c\:8ba1\:7b97\:56de\:4ee3\:6807\:51c6\:503c\:662f\:6052\:7b49\:5173\:7cfb\:ff0c\:4e0d\:662f\:72ec\:7acb\:6ce2\:957f\:9a8c\:8bc1\:3002","\:7f3a\:6807\:51c6\:6ce2\:957f\:3001\:4eea\:5668\:5206\:5ea6\:548c\:5b9a\:4f4d\:7cfb\:7edf\:8bef\:5dee\:ff1b\:4f20\:64ad\:53ea\:5305\:542b\:91cd\:590d\:6027\:5206\:91cf\:3002","\:90e8\:5206\:4e24\:6e38\:6807\:53cc\:4fa7\:89d2\:5dee\:660e\:663e\:4e0d\:4e00\:81f4\:ff0c\:6570\:636e\:4fdd\:7559\:4f46\:9650\:5236\:8c31\:7ebf\:8bc6\:522b\:548c\:8272\:6563\:7ed3\:8bba\:3002"}|>
